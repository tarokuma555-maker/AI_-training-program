# サイトURL（マジックリンクのリダイレクト先。本番は https://～）
NEXT_PUBLIC_SITE_URL=

# Supabase（LPと同一プロジェクトを共有。プロジェクト設定 > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role キー（サーバー専用。クライアントに出さない）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic APIキー（AI質問室で使用）
ANTHROPIC_API_KEY=

# AI質問室：1人1日の質問回数上限（省略時 20）
AI_CHAT_DAILY_LIMIT=20
