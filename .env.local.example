# Supabase（フェーズ2以降で使用）
# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。クライアントに公開しないこと（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API（フェーズ3のAI一次判定で使用）
ANTHROPIC_API_KEY=

# サイトURL（OGP等のメタ情報で使用。例: https://example.com）
NEXT_PUBLIC_SITE_URL=
